# ============================================================
# DeepSeek 私有化聊天服务配置（复制为 server/.env 后修改）
# 所有项都有默认值，最少只需要改 ADMIN_PASSWORD
# ============================================================

# 监听地址与端口（0.0.0.0 表示允许局域网/公网访问）
HOST=0.0.0.0
PORT=8000

# 首个管理员的用户名与密码（仅在数据库中没有任何用户时生效）
ADMIN_USERNAME=admin
# 强烈建议设置强密码；留空则自动生成随机密码并写入 server/data/initial-admin-password.txt
ADMIN_PASSWORD=

# DeepSeek API 地址（一般无需修改）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 也可以在环境变量里直接提供 API Key（后台保存的 Key 优先级更高）
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# 数据目录（SQLite 数据库、密钥文件、日志都在这里）
DATA_DIR=./data

# 可选：固定用于加密 API Key 的口令（留空则自动生成 data/secret.key）
# 一旦设置后不要随意修改，否则已保存的 API Key 将无法解密
# APP_SECRET=

# 前端静态文件目录（默认项目根目录下的 web/）
# WEB_DIR=../web

# 会话 Cookie 有效期（小时）
SESSION_TTL_HOURS=168

# 通过 HTTPS 访问时设为 true（推荐），HTTP 部署保持 false
COOKIE_SECURE=false

# 登录失败限流：窗口期（秒）内最多尝试次数
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=300

# 单次请求体大小上限（MB），上传图片/文档时可适当调大
MAX_BODY_MB=100

# 上游流式响应读超时（秒）
UPSTREAM_READ_TIMEOUT=600

# 额外的允许来源（一般不需要；反向代理同源时留空）
# ALLOWED_ORIGINS=https://chat.example.com
